# ── Payload CMS (админка /admin) ──
# Postgres. Локально: postgres://<user>@localhost:5432/dream_cms
# Прод: строка подключения Neon/Supabase/Vercel Postgres.
DATABASE_URI=postgres://user@localhost:5432/dream_cms
# Секрет для подписи сессий. Сгенерировать: openssl rand -hex 32
PAYLOAD_SECRET=

NEXT_PUBLIC_SITE_URL=https://dream.agency

# Google Tag Manager is the default place for Google Ads conversion tags.
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Meta Pixel browser tracking.
NEXT_PUBLIC_META_PIXEL_ID=000000000000000

# Meta Conversions API server tracking.
META_PIXEL_ID=000000000000000
META_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

# Optional direct Google Ads tracking. Keep false when GTM sends Google Ads conversions.
NEXT_PUBLIC_GOOGLE_ADS_DIRECT_TRACKING=false
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-000000000
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=conversion_label

# TikTok Pixel browser tracking.
NEXT_PUBLIC_TIKTOK_PIXEL_ID=XXXXXXXXXXXXXXXXXXXX

# CRM lead handoff.
CRM_WEBHOOK_URL=
CRM_WEBHOOK_TOKEN=